{
  "name": "beuve",
  "version": "0.1.0",
  "description": "Code review and verification workbench",
  "private": true,
  "type": "module",
  "license": "0BSD",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "error"
    }
  },
  "imports": {
    "#contract/*": "./src/contract/*",
    "#git/*": "./src/git/*",
    "#internal/*": "./src/internal/*",
    "#jsonrpc/*": "./src/jsonrpc/*",
    "#release/*": "./src/release/*",
    "#sqlite/*": "./src/sqlite/*",
    "#testing/*": "./src/testing/*",
    "#x/*": "./src/x/*"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json && tsc -p .storybook/tsconfig.json",
    "typecheck:ci": "npm run typecheck",
    "lint": "eslint --max-warnings 0 .",
    "lint:ci": "npm run lint",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.js",
    "deps:ci": "npm run deps",
    "storybook:ci": "storybook build --output-dir dist-storybook --quiet",
    "audit:ci": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=github-actions",
    "test:watch": "vitest",
    "build": "node scripts/build.ts",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir dist-storybook",
    "release": "node scripts/release.ts",
    "build:icon": "node scripts/build-icon.ts",
    "check": "npm run typecheck && npm run lint && npm run format:ci && npm run deps && npm run test",
    "start": "npm run build && electron .",
    "fetch-node": "node scripts/fetch-node.ts",
    "check:packaged": "node scripts/check-packaged-app.ts",
    "check:signatures": "node scripts/check-signatures.ts",
    "dist:mac": "npm run build && node scripts/fetch-node.ts --target darwin-arm64 && node scripts/dist-mac.ts",
    "dist:linux-dir": "npm run build && node scripts/fetch-node.ts --target linux-x64 && electron-builder --linux dir",
    "dist:linux": "npm run build && node scripts/fetch-node.ts --target linux-x64 && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@pierre/diffs": "1.6.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lit": "3.3.3",
    "node-pty": "1.1.0",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.2",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint/js": "10.0.1",
    "@storybook/web-components-vite": "10.6.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.0",
    "electron": "45.1.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true
  }
}
