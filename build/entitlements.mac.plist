<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 (main, renderer, utility helpers, WebAssembly) needs JIT under the hardened runtime. The bundled Node keeps its own signature and entitlements (ADR 0085). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
